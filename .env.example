# CampusRide environment configuration. Copy to .env for local dev.
# Do not commit .env. Every variable below is documented.

# --- App ---
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
DATABASE_URL=sqlite:///./campusride.db
# For Postgres:
# DATABASE_URL=postgresql+psycopg://campusride:campusride@db:5432/campusride

# --- i18n ---
DEFAULT_LANG=en
SUPPORTED_LANGS=en,bn

# --- Campus ---
CAMPUS_NAME=North Campus
CAMPUS_TIMEZONE=Asia/Dhaka
EMERGENCY_NUMBER=999
MEMBER_CAP=200
RETENTION_DAYS=90
TRIP_HORIZON_DAYS=14
LAST_MINUTE_WINDOW_MINUTES=120
TIME_MATCH_TOLERANCE_MINUTES=15
COST_PER_SEAT_CAP_PAISA=50000

# --- Workers ---
RUN_WORKER_IN_PROCESS=false
HEARTBEAT_INTERVAL_SECONDS=30

# --- Telegram (optional) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=

# --- Safety features ---
WOMEN_ONLY_TRIPS=false

# --- Demo ---
DEMO_MODE=false
